korin 1
title "Run the deploy workflow as the bot"

param environment = "production"

stage "Token"
  read aws ssm get-parameter --name /ci/deploy-bot-token --with-decryption --output json
    capture secret token = jq .Parameter.Value

stage "Deploy"
  # gh reads GH_TOKEN from its environment. The display shows «secret:token».
  mutate gh workflow run deploy.yml --ref main -f environment={environment}
    env GH_TOKEN={token}
