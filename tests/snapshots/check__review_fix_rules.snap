source: tests/check.rs
expression: "check(&[(\"main.korin\",\nconcat!(\"korin 1\\ntitle \\\"t\\\"\\n\", \"use \\\"./lib/m.korin\\\"\\n\",\n\"param pw secret\\n\", \"param conn = \\\"postgres://app:{pw}@db\\\"\\n\",\n\"stage \\\"a\\\"\\n\", \"  interactive psql {conn}\\n\", \"  poll every 1s for 5s\\n\",\n\"    mutate tool restart\\n\", \"    confirm \\\"again?\\\"\\n\",\n\"    read tool status\\n\", \"      capture s = text\\n\",\n\"    until s == \\\"ok\\\"\\n\", \"  read tool\\n\",\n\"    capture secret t = file {korin.out}/../escape text\\n\",\n\"  m.show({korin.out})\\n\",),),\n(\"lib/m.korin\", \"define show(p)\\n  note \\\"path {p}\\\"\\n\"),])"
